# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored at the repo root.
# Get an xAI key from https://console.x.ai/

# Preferred for Grok (OpenAI-compatible Chat Completions)
XAI_API_KEY=

# Alternative: OpenAI or any compatible provider
# OPENAI_API_KEY=

# Defaults (only set if you need to override)
# TUNDRA_LLM_BASE_URL=https://api.x.ai/v1
# TUNDRA_LLM_MODEL=grok-3
