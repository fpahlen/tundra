{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fpahlen/tundra/schema/tundra.schema.json",
  "title": "Tundra model",
  "description": "Pretty-YAML structure for a Tundra model (.tundra). Supports domain process models and regulatory models with regulation + cite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tundra",
    "roles",
    "contracts",
    "scenarios"
  ],
  "properties": {
    "tundra": {
      "type": "string",
      "minLength": 1,
      "description": "Short model name"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Role is Relationship of subject (plain English)"
              },
              "source": {
                "type": "string",
                "enum": [
                  "stated",
                  "inferred"
                ],
                "description": "stated = human said it; inferred = AI assumed \u2014 must confirm before export"
              }
            }
          }
        ]
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "description": "Stable Contract id for enforced_by and scenario references"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Plain-English Contract text"
              },
              "source": {
                "type": "string",
                "enum": [
                  "stated",
                  "inferred"
                ],
                "description": "stated = human said it; inferred = AI inferred \u2014 must be confirmed before export"
              },
              "rationale": {
                "type": "string",
                "description": "Why this rule exists (human context; not machine-checked or codegen)"
              },
              "cite": {
                "type": "array",
                "minItems": 1,
                "description": "Legal provenance (article/paragraph primary; page optional)",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "article"
                  ],
                  "properties": {
                    "article": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Article number as in the instrument (e.g. \"5\", \"6\")"
                    },
                    "paragraph": {
                      "type": "string",
                      "description": "Paragraph or point (e.g. \"2\", \"2(a)\", \"8\")"
                    },
                    "page": {
                      "type": [
                        "string",
                        "integer"
                      ],
                      "description": "Optional page in the pinned OJ/PDF edition only"
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 400,
                      "description": "Optional short verbatim snip for disambiguation"
                    },
                    "point": {
                      "type": "string",
                      "description": "Point letter e.g. a for 2(a); may also be embedded in paragraph"
                    }
                  }
                }
              },
              "translation_review": {
                "type": "object",
                "additionalProperties": false,
                "description": "Human sign-off that Contract text matches cited law (not enforced as truth)",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "unreviewed",
                      "reviewed"
                    ]
                  },
                  "reviewer": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "description": "ISO date"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "expires_in": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "capacity": {
                "type": [
                  "string",
                  "number",
                  "integer"
                ]
              },
              "quantity": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "contains": {
                "type": "string",
                "minLength": 1
              },
              "final": {
                "type": "boolean",
                "description": "If true, state is intentionally terminal (no Process must require it)"
              }
            }
          }
        ]
      }
    },
    "processes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "actor",
          "requires"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "results": {
            "description": "AND of outcomes (all apply). Mutually exclusive with outcomes.",
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "description": "Mutually exclusive branches (XOR). Mutually exclusive with top-level results.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "when",
                "results"
              ],
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Plain-English condition; use 'otherwise' for the default branch (must be last)"
                },
                "results": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                }
              }
            }
          },
          "enforced_by": {
            "type": "array",
            "description": "Contract ids that govern this Process",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "within": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": [
              "string",
              "number"
            ]
          },
          "expires_in": {
            "type": [
              "string",
              "number"
            ]
          },
          "capacity": {
            "type": [
              "string",
              "number",
              "integer"
            ]
          },
          "contains": {
            "type": "string",
            "minLength": 1
          },
          "cite": {
            "type": "array",
            "minItems": 1,
            "description": "Legal provenance (article/paragraph primary; page optional)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "article"
              ],
              "properties": {
                "article": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Article number as in the instrument (e.g. \"5\", \"6\")"
                },
                "paragraph": {
                  "type": "string",
                  "description": "Paragraph or point (e.g. \"2\", \"2(a)\", \"8\")"
                },
                "page": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "description": "Optional page in the pinned OJ/PDF edition only"
                },
                "quote": {
                  "type": "string",
                  "maxLength": 400,
                  "description": "Optional short verbatim snip for disambiguation"
                },
                "point": {
                  "type": "string",
                  "description": "Point letter e.g. a for 2(a); may also be embedded in paragraph"
                }
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "regulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instrument"
      ],
      "description": "Pin the legal instrument this model reframes (regulatory models)",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Short instrument id (any regulation; project-chosen)"
        },
        "instrument": {
          "type": "string",
          "minLength": 1,
          "description": "Full legal name of the instrument"
        },
        "eli": {
          "type": "string",
          "minLength": 1,
          "description": "Stable official URL (ELI or equivalent)"
        },
        "edition": {
          "type": "string",
          "description": "Pinned edition string \u2014 required if any cite uses page"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "lifecycle",
        "obligations"
      ],
      "description": "lifecycle = states/processes/genesis (default when processes present). obligations = standing duties; states/processes optional; scenarios required."
    }
  }
}
