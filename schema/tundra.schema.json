{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fpahlen/tundra/schema/tundra.schema.json",
  "title": "Tundra model",
  "description": "Pretty-YAML structure for a Tundra business-process model (.tundra files).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tundra", "roles", "contracts", "states", "processes", "scenarios"],
  "properties": {
    "tundra": {
      "type": "string",
      "minLength": 1,
      "description": "Short model name"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "relationships": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "description": "Stable Contract id for enforced_by and scenario references"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Plain-English Contract text"
              }
            }
          }
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "expires_in": { "type": ["string", "number"] },
              "capacity": { "type": ["string", "number", "integer"] },
              "quantity": { "type": ["string", "number"] },
              "contains": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "actor", "requires", "results"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "requires": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            ]
          },
          "results": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            ]
          },
          "enforced_by": {
            "type": "array",
            "description": "Contract ids that govern this Process",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 },
          "within": { "type": "string", "minLength": 1 },
          "quantity": { "type": ["string", "number"] },
          "expires_in": { "type": ["string", "number"] },
          "capacity": { "type": ["string", "number", "integer"] },
          "contains": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
