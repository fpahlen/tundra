# INTENTIONAL BAD MODEL — do not treat as a quality reference.
#
# Several Contracts are deliberately untestable (e.g. "high relative to income",
# "low relative to income", "fall between automatic approval and automatic decline").
# This file is a larger counter-example and a fixture for testing the prompts
# (especially validate-tundra and extract-tundra's refusal of vague Contracts).
# Structure is valid YAML (including genesis). Contract quality is intentionally poor.
# See README.md in this folder.

tundra: Loan application entry and credit decision

roles:
  - Applicant
  - Loan Officer

relationships:
  - Applicant is Applicant of Application
  - Loan Officer is Reviewer of Application

contracts:
  - The Applicant must successfully identify with Swedish BankID to create an account and start a loan application
  - If BankID identification fails or is cancelled, the application is automatically declined
  - A UC credit check must be performed (or a previous check reused) before a credit decision is made
  - A previous UC credit check may be reused only if it is less than 6 months old
  - If the requested loan is high relative to the Applicant’s income or the Applicant has betalningsanmärkningar, the application is automatically declined
  - If the requested loan is low relative to the Applicant’s income and the Applicant has no missed payments, the application is automatically approved
  - Applications that fall between automatic approval and automatic decline must be reviewed and decided by a Loan Officer

states:
  - Application is BankID in progress
  - Application is Credit check required
  - Application is Credit check completed
  - Application is Automatically approved
  - Application is Automatically declined
  - Application is Pending Loan Officer review
  - Application is Approved by Loan Officer
  - Application is Declined by Loan Officer

processes:
  - name: Start application with BankID
    actor: Applicant
    requires: no Application exists
    results: Application is BankID in progress

  - name: Complete BankID identification
    actor: Applicant
    requires: Application is BankID in progress
    results: Application is Credit check required

  - name: Fail BankID identification
    actor: System
    requires: Application is BankID in progress
    results: Application is Automatically declined

  - name: Perform or reuse UC credit check
    actor: System
    requires: Application is Credit check required
    results: Application is Credit check completed

  - name: Make automatic credit decision
    actor: System
    requires: Application is Credit check completed
    outcomes:
      - when: the requested loan is high relative to income or the Applicant has betalningsanmärkningar
        results: Application is Automatically declined
      - when: the requested loan is low relative to income and the Applicant has no missed payments
        results: Application is Automatically approved
      - when: otherwise
        results: Application is Pending Loan Officer review

  - name: Loan Officer approves
    actor: Loan Officer
    requires: Application is Pending Loan Officer review
    results: Application is Approved by Loan Officer

  - name: Loan Officer declines
    actor: Loan Officer
    requires: Application is Pending Loan Officer review
    results: Application is Declined by Loan Officer

scenarios:
  - name: "Happy path: low risk applicant is automatically approved"
    steps:
      - Given no Application exists
      - When the Applicant starts the application with BankID
      - Then the Application is BankID in progress
      - When the Applicant successfully completes BankID identification
      - Then the Application is Credit check required
      - When a UC credit check is performed or a valid previous check is reused
      - Then the Application is Credit check completed
      - When the requested loan is low relative to income and there are no missed payments
      - Then the Application is Automatically approved
      - And the contract "If the requested loan is low relative to the Applicant’s income and the Applicant has no missed payments, the application is automatically approved" is applied

  - name: "Error: BankID identification fails"
    steps:
      - Given the Application is BankID in progress
      - When the BankID identification fails or is cancelled
      - Then the Application is Automatically declined
      - And the contract "If BankID identification fails or is cancelled, the application is automatically declined" is applied

  - name: "Error: high risk applicant is automatically declined"
    steps:
      - Given the Application is Credit check completed
      - When the requested loan is high relative to income or the Applicant has betalningsanmärkningar
      - Then the Application is Automatically declined
      - And the contract "If the requested loan is high relative to the Applicant’s income or the Applicant has betalningsanmärkningar, the application is automatically declined" is applied

  - name: "Manual review path"
    steps:
      - Given the Application is Credit check completed
      - When the application falls between automatic approval and automatic decline
      - Then the Application is Pending Loan Officer review
      - When the Loan Officer approves the application
      - Then the Application is Approved by Loan Officer
