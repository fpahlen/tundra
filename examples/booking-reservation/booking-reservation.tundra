# Canonical Tundra model (YAML). See tundra.md for the language definition.

tundra: Booking and reservation

roles:
  - Guest
  - Host

relationships:
  - Guest is Booker of Reservation
  - Host is Provider of Time slot
  - Guest is Participant of Reservation

contracts:
  - A Reservation may be created only for a time slot that is Available
  - Only the Guest who created a Reservation may cancel it while it is Confirmed
  - A Guest may cancel a Confirmed Reservation only more than 24 hours before start time
  - A Host may cancel a Reservation only before the start time
  - Once a Reservation is Completed it cannot be cancelled
  - The System marks a Reservation as No-show if the Guest does not arrive by start time

states:
  - name: Time slot is Available
    capacity: 1
  - Time slot is Reserved
  - name: Reservation is Pending
    expires_in: 15 minutes
  - Reservation is Confirmed
  - Reservation is Cancelled by Guest
  - Reservation is Cancelled by Host
  - Reservation is Completed
  - Reservation is No-show

processes:
  - name: Check availability
    actor: Guest
    requires: Time slot is Available
    results: Time slot is Available

  - name: Create Reservation
    actor: Guest
    requires: Time slot is Available
    results:
      - Reservation is Pending
      - Time slot is Reserved

  - name: Confirm Reservation
    actor: System
    requires: Reservation is Pending
    results: Reservation is Confirmed

  - name: Cancel by Guest
    actor: Guest
    requires: Reservation is Confirmed
    results: Reservation is Cancelled by Guest
    before: start time
    within: 24 hours before start

  - name: Cancel by Host
    actor: Host
    requires: Reservation is Confirmed
    results: Reservation is Cancelled by Host
    before: start time

  - name: Mark as Completed
    actor: System
    requires: Reservation is Confirmed
    results: Reservation is Completed
    after: end time

  - name: Mark as No-show
    actor: System
    requires: Reservation is Confirmed
    results: Reservation is No-show
    after: start time

scenarios:
  - name: "Happy path: guest books and stays"
    steps:
      - Given the Time slot is Available
      - When the Guest creates a Reservation
      - Then the Reservation is Pending
      - And the Time slot is Reserved
      - When the Reservation is confirmed
      - Then the Reservation is Confirmed
      - When the stay finishes successfully
      - Then the Reservation is Completed

  - name: "Error: guest tries to book an already reserved slot"
    steps:
      - Given the Time slot is Reserved
      - When a Guest tries to create a Reservation for the same slot
      - Then the reservation is rejected
      - And the contract "A Reservation may be created only for a time slot that is Available" is broken

  - name: "Error: guest cancels too late"
    steps:
      - Given the Reservation is Confirmed
      - And the start time is less than 24 hours away
      - When the Guest tries to cancel the Reservation
      - Then the cancellation is rejected
      - And the contract "A Guest may cancel a Confirmed Reservation only more than 24 hours before start time" is broken

  - name: "Error: guest does not arrive"
    steps:
      - Given the Reservation is Confirmed
      - And the start time has passed
      - When the System marks the Reservation as No-show
      - Then the Reservation is No-show
