# SAMPLE: pure obligations slice (no invented lifecycle).
# DORA Article 5(4) — management body ICT knowledge.

tundra: dora-art-5-4-board-competence
kind: obligations

regulation:
  id: DORA
  instrument: "Regulation (EU) 2022/2554"
  eli: "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"
  edition: "OJ L 333, 27.12.2022"
  notes: "Standing duty only — kind: obligations."

roles:
  - Management body
  - Financial entity

relationships:
  - Management body is Governing body of Financial entity

contracts:
  - id: mgmt-body-keeps-ict-knowledge-current
    text: >
      Members of the Management body of the Financial entity must keep up to date
      with knowledge and skills to understand and assess ICT risk and its impact
      on the operations of the Financial entity, including regular training
      commensurate with the ICT risk being managed.
    cite:
      - article: "5"
        paragraph: "4"
        quote: "Members of the management body of the financial entity shall actively keep up to date with sufficient knowledge and skills to understand and assess ICT risk"

scenarios:
  - name: "Error: board members without ICT risk training"
    steps:
      - Given the Financial entity is in scope of the instrument
      - When members of the Management body have no ongoing ICT risk training
      - Then the contract [mgmt-body-keeps-ict-knowledge-current] is broken
