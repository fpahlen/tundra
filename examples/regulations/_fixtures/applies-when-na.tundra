# applies_when: n/a must NOT silence scope check

tundra: applies-when-na-fixture
kind: obligations

regulation:
  id: DORA
  instrument: "Regulation (EU) 2022/2554"
  eli: "https://eur-lex.europa.eu/eli/reg/2022/2554/oj"
  edition: "OJ L 333, 27.12.2022"

roles:
  - Financial entity

contracts:
  - id: over-applies
    text: >
      Every Financial entity, including microenterprises, must establish a role
      to monitor ICT third-party arrangements.
    applies_when: n/a
    implement_as: recorded_control
    evidence:
      - type: policy
        description: Monitoring role terms of reference for ICT third-party arrangements
    cite:
      - article: "5"
        paragraph: "3"
        quote: "Financial entities, other than microenterprises, shall establish a role in order to monitor the arrangements concluded with ICT third-party service providers on the use of ICT services"
    translation_review:
      status: unreviewed

scenarios:
  - name: "Error"
    steps:
      - Given in scope
      - When there is no monitoring role
      - Then the contract [over-applies] is broken
