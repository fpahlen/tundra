# Canonical Tundra model (YAML). Second golden path for Contract ids + enforced_by.

tundra: E-commerce order lifecycle

roles:
  - Customer
  - Merchant
  - Payment Provider

relationships:
  - Customer is Owner of Cart
  - Customer is Owner of Order
  - Merchant is Handler of Order

contracts:
  - id: only-customer-cart-or-order
    text: Only a Customer may add items to a Cart or place an Order
  - id: order-needs-items
    text: An Order may be placed only from a Cart that contains at least one item
  - id: payment-before-paid
    text: Payment must succeed before an Order can move to Paid
  - id: only-merchant-ships
    text: Only the Merchant may mark an Order as Shipped or Delivered
  - id: cancel-while-placed-or-paid
    text: A Customer may cancel an Order only while it is in Placed or Paid state
  - id: no-cancel-after-shipped
    text: Once an Order is Shipped it can no longer be cancelled by the Customer

states:
  - Cart is Empty
  - name: Cart has Items
    contains: LineItems
    quantity: at least 1
  - Order is Placed
  - Order is Paid
  - Order is Shipped
  - name: Order is Delivered
    final: true
  - name: Order is Cancelled
    final: true
  - name: Order is Payment Failed
    final: true

processes:
  - name: Open Cart
    actor: Customer
    requires: no Cart exists
    results: Cart is Empty
    enforced_by:
      - only-customer-cart-or-order

  - name: Add item to Cart
    actor: Customer
    requires: Cart is Empty
    results: Cart has Items
    enforced_by:
      - only-customer-cart-or-order

  - name: Remove item from Cart
    actor: Customer
    requires: Cart has Items
    results: Cart is Empty
    enforced_by:
      - only-customer-cart-or-order

  - name: Place Order
    actor: Customer
    requires: Cart has Items
    results: Order is Placed
    quantity: at least 1
    enforced_by:
      - only-customer-cart-or-order
      - order-needs-items

  - name: Capture Payment
    actor: Payment Provider
    requires: Order is Placed
    results: Order is Paid
    enforced_by:
      - payment-before-paid

  - name: Fail Payment
    actor: Payment Provider
    requires: Order is Placed
    results: Order is Payment Failed

  - name: Mark as Shipped
    actor: Merchant
    requires: Order is Paid
    results: Order is Shipped
    enforced_by:
      - only-merchant-ships

  - name: Mark as Delivered
    actor: Merchant
    requires: Order is Shipped
    results: Order is Delivered
    enforced_by:
      - only-merchant-ships

  - name: Cancel Order
    actor: Customer
    requires:
      - Order is Placed
      - Order is Paid
    results: Order is Cancelled
    before: Shipped
    enforced_by:
      - cancel-while-placed-or-paid
      - no-cancel-after-shipped

scenarios:
  - name: "Happy path: customer buys and receives goods"
    steps:
      - Given no Cart exists
      - When the Customer opens a Cart
      - Then the Cart is Empty
      - When the Customer adds an item to the Cart
      - Then the Cart has Items
      - When the Customer places the Order
      - Then the Order is Placed
      - When the Payment Provider captures payment successfully
      - Then the Order is Paid
      - When the Merchant marks the Order as Shipped
      - Then the Order is Shipped
      - When the Merchant marks the Order as Delivered
      - Then the Order is Delivered

  - name: "Error: payment fails"
    steps:
      - Given the Order is Placed
      - When the Payment Provider fails to capture payment
      - Then the Order is Payment Failed

  - name: "Error: customer tries to cancel after shipping"
    steps:
      - Given the Order is Shipped
      - When the Customer tries to cancel the Order
      - Then the cancellation is rejected
      - And the Order remains Shipped
      - And the contract [no-cancel-after-shipped] is broken

  - name: "Error: place order from empty cart"
    steps:
      - Given the Cart is Empty
      - When the Customer tries to place an Order
      - Then the order is rejected
      - And the contract [order-needs-items] is broken
